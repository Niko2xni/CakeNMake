MONGO_URI=

# Cake AI: choose vercel, openrouter, gemini, or anthropic.
# OpenRouter requires a model that supports tool calling.
AI_PROVIDER=vercel
# Conservative shared daily AI token-unit budget (not a dollar billing cap).
AI_DAILY_TOKEN_BUDGET=1000000
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=alibaba/qwen3.8-omni-flash
# Optional image-capable model for reference analysis; defaults to AI_GATEWAY_MODEL.
AI_GATEWAY_VISION_MODEL=
# Optional image-capable OpenRouter model; defaults to OPENROUTER_MODEL.
OPENROUTER_VISION_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Use Brevo HTTPS delivery on Render Free. Existing installations default to smtp
# when AUTH_EMAIL_PROVIDER is absent. Brevo FROM must be a verified bare address.
AUTH_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_NAME=CakeNMake

# Only needed when AUTH_EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required in production so OTPs survive restarts and work across instances.
REDIS_URL=

# Exact comma-separated browser origins allowed by Express and Socket.IO.
CLIENT_ORIGINS=http://localhost:5173
SOCKET_PATH=/socket.io
SOCKET_MAX_HTTP_BUFFER_BYTES=1000000
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
